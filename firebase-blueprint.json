{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile metadata for the wardrobe owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "WardrobeItem": {
      "title": "WardrobeItem",
      "description": "A clothing item or accessory stored in a user's wardrobe.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": ["상의", "원피스", "바지", "치마", "아우터", "스포츠웨어", "신발", "가방", "액세서리"]
        },
        "subCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "seasons": {
          "type": "array",
          "description": "Seasons when this item is worn (봄, 여름, 가을, 겨울)."
        },
        "tpo": {
          "type": "string",
          "maxLength": 40
        },
        "colorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "colorHex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "maxLength": 7
        },
        "price": {
          "type": "number"
        },
        "purchaseDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "material": {
          "type": "string",
          "maxLength": 60
        },
        "pattern": {
          "type": "string",
          "maxLength": 40
        },
        "size": {
          "type": "string",
          "maxLength": 20
        },
        "rating": {
          "type": "number"
        },
        "imageKey": {
          "type": "string",
          "maxLength": 60
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "additionalImages": {
          "type": "array",
          "description": "Bounded list of additional photo URLs or compressed data URLs."
        },
        "memo": {
          "type": "string",
          "maxLength": 1000
        },
        "isBasicCloset": {
          "type": "boolean"
        },
        "wearCountOffset": {
          "type": "number",
          "description": "Optional integer offset added to daily look count for manual wear count adjustment."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "brand",
        "category",
        "subCategory",
        "seasons",
        "colorName",
        "colorHex",
        "price",
        "purchaseDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailyLook": {
      "title": "DailyLook",
      "description": "A recorded outfit combination worn on a specific date with weather context.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "weatherCondition": {
          "type": "string",
          "enum": ["sunny", "partly_cloudy", "cloudy", "rainy", "snowy"]
        },
        "tempHigh": {
          "type": "number"
        },
        "tempLow": {
          "type": "number"
        },
        "itemIds": {
          "type": "array",
          "description": "Bounded array of WardrobeItem IDs included in this outfit."
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "date",
        "weatherCondition",
        "tempHigh",
        "tempLow",
        "itemIds",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Owner-only user profile document serving as the parent gate for wardrobe subcollections."
    },
    "/users/{userId}/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/WardrobeItem"
      },
      "description": "User's personal wardrobe items."
    },
    "/users/{userId}/dailyLooks/{lookId}": {
      "schema": {
        "$ref": "#/entities/DailyLook"
      },
      "description": "User's recorded daily look outfit combinations linked to wardrobe items."
    }
  }
}
